rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Agrupacions ----
    // L'app pot allotjar moltes agrupacions (cors, orquestres, bandes…). Cadascuna té les seves
    // dades a cors/<agrupació>/… i una fitxa al directori agrupacions/<agrupació> amb el nom,
    // el tipus i l'estat (active | suspended | deleted). Cap agrupació pot veure res d'una altra.
    //
    // ---- Qui és qui dins d'una agrupació ----
    // Ningú no hi entra sense identificar-se: tothom entra amb el seu compte de Google i té una fitxa
    // a cors/<agrupació>/staff/<correu> amb un o més rols (roles; les fitxes antigues, un sol role):
    //   admin                     → ho pot fer tot: persones, identitat, dades
    //   director | gerencia       → porten les produccions, les sessions i els Ajustos (prodEdit) i el tauler (boardEdit) i
    //                               veuen l'assistència de tot el cor; la direcció també respon les absències de tothom
    //   secretaria                → porta les persones (peopleEdit: fitxes, perfils, documents i quotes) i el tauler
    //   leader                    → cap de corda o de secció: passa llista i respon les absències de la seva corda
    //   voice                     → professor de cant: porta les classes (classes i classReq) i veu només els seus alumnes
    //   archive                   → arxiver d'una corda (section): porta el repertori (obres, partitures, àudios, materials) i
    //                             reparteix i recull les partitures en paper (scores) de totes les cordes; la resta, només lectura
    //   festes                    → comissió de festes (cantaires): porta el tauler amb l'equip (boardPost: anuncis, enquestes i
    //                             bandes, documents i sortides; el repertori no), en veu els vots i escriu missatges a tothom
    //   singer                    → només lectura de tota l'app
    // Cadascú pot fer el que diuen tots els seus rols sumats (vegeu js/03b-rols.js). Les al·lèrgies (health) només les
    // veuen la persona, la secretaria i la gerència.
    // La fitxa pot portar memberId: llavors la persona té el seu espai personal, sigui quin sigui el rol.
    // Cada persona té un índex de les seves agrupacions a staffIndex/<correu>/agrupacions/<agrupació>.
    //
    // ---- Plataforma i Usuaris Pro ----
    // plataforma/equip diu qui porta la plataforma: veu el directori, pot suspendre agrupacions (però no
    // en veu les dades de dins) i decideix qui és Usuari Pro. plataforma/pro és la llista d'Usuaris Pro.
    // Només un Usuari Pro (l'equip de la plataforma ho és sempre) pot crear agrupacions i, de les que
    // administra, canviar-ne la identitat (nom, tipus, seccions, imatge) o esborrar-les.
    // El compte de servei (avisos, calendari, còpies) llegeix totes les agrupacions i no escriu res.
    //
    // ---- Lectors antics de les tasques automàtiques ----
    // claus/<secret> diu l'agrupació i el rol (calendar o backup); cada lector anònim es registra a
    // cors/<agrupació>/access/<uid>. Només llegeixen. Ja no hi ha cap enllaç per entrar a l'app.

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', '').lower(); }
    function verified() { return signedIn() && request.auth.token.get('email_verified', false) == true; }

    // Primera agrupació: la seva administració pot activar el panell de plataforma el primer cop.
    function founder() { return 'nSN9kYDkzPik239jnsMsCSYW'; }
    function isService() { return signedIn() && request.auth.uid in ['sZy09w2YOfdv2jky8zy5m7Vzfna2']; }
    function isPlatform() {
      return verified()
        && exists(/databases/$(database)/documents/plataforma/equip)
        && email() in get(/databases/$(database)/documents/plataforma/equip).data.emails;
    }

    function isPro() {
      return isPlatform()
        || (verified()
            && exists(/databases/$(database)/documents/plataforma/pro)
            && email() in get(/databases/$(database)/documents/plataforma/pro).data.emails);
    }

    function dirDoc(c) { return /databases/$(database)/documents/agrupacions/$(c); }
    // Una agrupació sense fitxa al directori (la primera, abans de registrar-la) compta com a activa.
    function groupOk(c) { return !exists(dirDoc(c)) || get(dirDoc(c)).data.get('status', 'active') == 'active'; }
    function staffPath(c) { return /databases/$(database)/documents/cors/$(c)/staff/$(email()); }
    // Té fitxa a l'agrupació, encara que estigui suspesa (per poder-li dir).
    function isMember(c) { return verified() && exists(staffPath(c)); }
    function isStaff(c) { return isMember(c) && groupOk(c); }
    function staffData(c) { return get(staffPath(c)).data; }
    function hasRole(c, roles) {
      let accP = /databases/$(database)/documents/cors/$(c)/access/$(request.auth.uid);
      return signedIn()
        && exists(accP)
        && get(accP).data.role in roles
        && exists(/databases/$(database)/documents/claus/$(get(accP).data.key))
        && groupOk(c);
    }
    // Els rols d'una fitxa: la llista roles o, a les fitxes d'abans, el rol únic.
    function rolesOf(d) { return d.get('roles', [d.get('role', '')]); }

    function canEdit(c) { return isStaff(c) && rolesOf(staffData(c)).hasAny(['admin', 'director', 'gerencia', 'secretaria', 'leader']); }
    function isAdmin(c) { return isStaff(c) && rolesOf(staffData(c)).hasAny(['admin']); }
    // Rols de la fitxa del personal (hasRole és el dels enllaços antics): per als missatges, les notes i la secretaria.
    function staffHas(c, roles) { return isStaff(c) && rolesOf(staffData(c)).hasAny(roles); }
    // El tauler (anuncis, enquestes, sortides, repertori, materials i documents) el porten l'administració, la direcció, la
    // gerència i la secretaria (el repertori, també els arxivers). Els caps de corda passen llista, però no hi editen res.
    function boardEdit(c) { return staffHas(c, ['admin', 'director', 'gerencia', 'secretaria']); }
    // Qui hi publica i en veu les respostes: l'equip del tauler i la comissió de festes (cantaires que porten la vida del cor:
    // anuncis, enquestes i bandes, documents i sortides). El repertori i les partitures, no: són de l'equip i dels arxivers.
    function boardPost(c) { return staffHas(c, ['admin', 'director', 'gerencia', 'secretaria', 'festes']); }
    // Les produccions, les seves sessions i els Ajustos: l'administració, la direcció i la gerència (Gestió › Produccions).
    function prodEdit(c) { return staffHas(c, ['admin', 'director', 'gerencia']); }
    // Les persones (Gestió › Personal): les fitxes de la plantilla, els comptes, els telèfons i les fitxes personals.
    function peopleEdit(c) { return staffHas(c, ['admin', 'director', 'gerencia', 'secretaria']); }
    // L'assistència de tot el cor (llistes, absències i arxiu) la llegeixen l'administració, la direcció i la gerència; un cap
    // de corda, només la de la seva corda (sec). Els cantaires, cadascú la seva (attMine).
    function attAll(c) { return staffHas(c, ['admin', 'director', 'gerencia']); }
    function attSec(c, sec) { return attAll(c) || (staffHas(c, ['leader']) && staffSection(c) == sec); }
    // L'escriuen (passar llista, respondre les absències, arxivar) l'administració i la direcció, de totes les cordes, i el cap
    // de corda, de la seva. La gerència només la llegeix.
    function attWriteAll(c) { return staffHas(c, ['admin', 'director']); }
    function attSecW(c, sec) { return attWriteAll(c) || (staffHas(c, ['leader']) && staffSection(c) == sec); }
    // Les al·lèrgies i intoleràncies (dades de salut): només la secretaria i la gerència, per als àpats de sortides i concerts.
    function healthRead(c) { return staffHas(c, ['secretaria', 'gerencia']); }
    // La corda d'una fitxa de la plantilla.
    function memberSec(c, mid) { return get(/databases/$(database)/documents/cors/$(c)/members/$(mid)).data.get('section', '-'); }
    // Un substitut val per a la sessió i la corda del seu nom (<sessió>_<corda>) i caduca com a molt dos dies després de la sessió.
    function subOk(id, d) {
      return id == d.get('sessionId', '') + '_' + d.get('section', '')
        && d.get('until', 0) is number && d.get('date', '') is string && d.get('date', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && subUntilOk(d.until, d.date.split('-'));
    }
    function subUntilOk(until, ymd) {
      return until <= timestamp.date(int(ymd[0]), int(ymd[1]), int(ymd[2])).toMillis() + 172800000;
    }
    function boardCol(col) { return col in ['announcements', 'polls', 'pollVotes', 'works', 'trips']; }
    function staffSection(c) { return staffData(c).get('section', '-'); }
    // La corda de qui llegeix, segons la seva fitxa de la plantilla.
    function memberSection(c) {
      let p = /databases/$(database)/documents/cors/$(c)/members/$(myMember(c));
      return exists(p) ? get(p).data.get('section', '-') : '-';
    }
    // El membre de la plantilla de qui som (si la fitxa en porta).
    function myMember(c) { return staffData(c).get('memberId', '-'); }
    // Té espai personal: pot avisar, confirmar, votar i fer de substitut.
    function hasSpace(c) { return isStaff(c); }
    // Porta les classes de cant: el professorat i l'administració.
    function teaches(c) { return isStaff(c) && rolesOf(staffData(c)).hasAny(['voice', 'admin']); }
    // Del professorat, cadascú només veu els seus alumnes: les notes i els enregistraments diuen de quin professor són (teacher)
    // i la fitxa de l'alumne, qui el porta (teachers). L'administració ho veu tot.
    function teacherOf(c, d) { return teaches(c) && (isAdmin(c) || d.get('teacher', '') == email()); }
    function teachersOf(c, d) { return teaches(c) && (isAdmin(c) || email() in d.get('teachers', [])); }
    // Pot canviar la identitat de l'agrupació o esborrar-la: n'és administrador i és Usuari Pro.
    function canManage(c) { return isAdmin(c) && isPro(); }
    // Camps de config/main que fan d'identitat de l'agrupació.
    function identityKeys() { return ['name', 'shortName', 'kind', 'sections', 'brand', 'labels', 'deleted', 'deletedAt']; }
    function mine(c, mid) { return mid == myMember(c) && mid != '-'; }
    // El vestidor: qui el porta per a tothom, i el que pot escriure la persona quan demana la seva peça.
    function wardStaff(c) { return staffHas(c, ['admin', 'secretaria', 'gerencia']); }
    function wardOwn(d) {
      return d.keys().hasOnly(['id', 'memberId', 'memberName', 'section', 'item', 'size', 'status', 'note', 'history', 'createdAt', 'updatedAt', 'by'])
        && shortText(d, 'item', 40) && shortText(d, 'size', 12) && shortText(d, 'note', 300) && shortText(d, 'memberName', 120)
        && shortText(d, 'section', 12) && shortText(d, 'by', 120) && shortText(d, 'createdAt', 40) && shortText(d, 'updatedAt', 40)
        && (!('history' in d) || (d.history is list && d.history.size() <= 30));
    }
    // Llistes d'assistència privades (Ajustos): qui no les passa només veu la seva còpia, a attMine/<membre>.
    function attPrivate(c) { return get(/databases/$(database)/documents/cors/$(c)/config/main).data.get('attPrivate', false) == true; }
    // Una conversa privada: la persona de la plantilla i qui té el rol (els caps de corda, només de la seva corda) o el correu a qui ha escrit.
    function inThread(c, d) {
      return (hasSpace(c) && mine(c, d.memberId))
        || (d.toEmail != '' && d.toEmail == email() && isStaff(c))
        || (d.toRole in ['admin', 'director', 'gerencia', 'secretaria'] && staffHas(c, [d.toRole]))
        || (d.toRole == 'leader' && staffHas(c, ['leader']) && staffSection(c) == d.section);
    }

    // Un compte de la plantilla que compta per primer cop que ha vist un anunci que existeix (vegeu annSeen).
    function seenOnce(c, aid) {
      return isStaff(c) && myMember(c) != '-' && memberSection(c) != '-'
        && exists(/databases/$(database)/documents/cors/$(c)/announcements/$(aid))
        && !exists(/databases/$(database)/documents/cors/$(c)/annSeen/$(aid)/by/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/cors/$(c)/annSeen/$(aid)/by/$(request.auth.uid));
    }

    // Una persona de la plantilla compta per primer cop que ha votat unes bandes: el seu vot hi és després del lot, i
    // turnout/<votació>/by/<persona> no hi era abans i sí després (vegeu turnout).
    function votedOnce(c, pid) {
      return isStaff(c) && myMember(c) != '-' && memberSection(c) != '-'
        && existsAfter(/databases/$(database)/documents/cors/$(c)/pollVotes/$(pid + '_' + myMember(c)))
        && !exists(/databases/$(database)/documents/cors/$(c)/turnout/$(pid)/by/$(myMember(c)))
        && existsAfter(/databases/$(database)/documents/cors/$(c)/turnout/$(pid)/by/$(myMember(c)));
    }
    // Les propostes de categories d'unes bandes es poden fer (i dir-hi «m'agrada») mentre la votació les recull.
    function propsOpen(c, pid) {
      return get(/databases/$(database)/documents/cors/$(c)/polls/$(pid)).data.get('propOpen', false) == true;
    }

    // Es crea una agrupació nova en aquest mateix lot d'escriptures: abans no hi havia res i després sí.
    function creating(c) {
      return !exists(dirDoc(c)) && existsAfter(dirDoc(c))
        && !exists(/databases/$(database)/documents/cors/$(c)/config/main)
        && existsAfter(/databases/$(database)/documents/cors/$(c)/config/main);
    }

    // ---- Versió de les regles ----
    // tools/stamp.py hi escriu l'empremta d'aquest fitxer. La vigilància comprova que les regles publicades són les del
    // repositori demanant reglesVersio/<empremta>: si les publicades són unes altres, la lectura es denega.
    match /reglesVersio/{v} {
      allow get: if v == 'bd070e7cb7ca';
    }

    match /plataforma/equip {
      allow get: if isPlatform() || resource == null;
      allow create: if verified()
        && exists(/databases/$(database)/documents/cors/$(founder())/staff/$(email()))
        && rolesOf(get(/databases/$(database)/documents/cors/$(founder())/staff/$(email())).data).hasAny(['admin'])
        && request.resource.data.keys().hasOnly(['emails', 'at'])
        && request.resource.data.emails == [email()];
      allow update: if isPlatform()
        && request.resource.data.keys().hasOnly(['emails', 'at'])
        && request.resource.data.emails is list
        && email() in request.resource.data.emails;
    }
    match /plataforma/pro {
      // Cadascú només pot saber si ell mateix hi és; la llista sencera, només la plataforma.
      allow get: if isPlatform() || (verified() && (resource == null || email() in resource.data.emails));
      allow create, update: if isPlatform()
        && request.resource.data.keys().hasOnly(['emails', 'at'])
        && request.resource.data.emails is list;
    }
    match /plataforma/config {
      allow get: if signedIn();
      allow create, update: if isPlatform();
    }

    // ---- Registre d'errors de l'app ----
    // Quan l'app falla al mòbil d'algú, hi deixa una nota breu (sense noms ni correus). Només la llegeixen la
    // plataforma i el compte de servei (la vigilància automàtica); ningú no la pot canviar ni esborrar. Només en deixen els comptes
    // d'una agrupació (gid): ni un compte anònim ni ningú de fora no pot omplir el registre ni gastar les escriptures del dia.
    function shortText(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.get('gid', '') is string
        && request.resource.data.get('gid', '').size() >= 20 && request.resource.data.get('gid', '').size() <= 40
        && isMember(request.resource.data.gid)
        && request.resource.data.keys().hasOnly(['kind', 'msg', 'where', 'at', 'app', 'gid', 'route', 'ua', 'online'])
        && request.resource.data.keys().hasAll(['kind', 'msg', 'at'])
        && request.resource.data.kind in ['error', 'promesa']
        && shortText(request.resource.data, 'msg', 400) && shortText(request.resource.data, 'where', 400)
        && shortText(request.resource.data, 'at', 40) && shortText(request.resource.data, 'app', 40)
        && shortText(request.resource.data, 'gid', 40) && shortText(request.resource.data, 'route', 80)
        && shortText(request.resource.data, 'ua', 220)
        && (!('online' in request.resource.data) || request.resource.data.online is bool);
      allow read: if isPlatform() || isService();
    }

    match /agrupacions/{c} {
      allow get: if isPlatform() || isService() || isMember(c);
      allow list: if isPlatform() || isService();
      // Nova agrupació (només Usuaris Pro): qui la crea en queda d'administrador, tot en un sol lot.
      allow create: if c.size() >= 20 && c.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'kind', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.status == 'active'
        && ((verified() && isPro()
              && request.resource.data.createdBy == email()
              && creating(c)
              && rolesOf(getAfter(/databases/$(database)/documents/cors/$(c)/staff/$(email())).data).hasAny(['admin']))
            // Registrar al directori una agrupació que ja existia d'abans.
            || (isAdmin(c) && exists(/databases/$(database)/documents/cors/$(c)/config/main)));
      allow update: if isPlatform()
        || (canManage(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'kind', 'stats'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80)
        || (canEdit(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']))
        || (canManage(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt'])
            && request.resource.data.status == 'deleted');
      allow delete: if isPlatform();
    }

    match /claus/{k} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && k.size() >= 24
        && request.resource.data.keys().hasOnly(['choirId', 'role', 'at', 'memberId'])
        && request.resource.data.role in ['calendar', 'backup']
        && isAdmin(request.resource.data.choirId);
      allow delete: if isAdmin(resource.data.choirId);
    }

    match /staffIndex/{e} {
      // Índex antic (una sola agrupació per correu). Ja no s'hi escriu, però es llegeix si falta el nou.
      allow get: if verified() && email() == e;
      allow create: if request.resource.data.keys().hasOnly(['choirId'])
        && request.resource.data.choirId == founder() && isAdmin(founder());
      allow update: if request.resource.data.keys().hasOnly(['choirId'])
        && resource.data.choirId == request.resource.data.choirId && isAdmin(resource.data.choirId);
      allow delete: if isAdmin(resource.data.choirId);

      // Les agrupacions de cada persona: només les pot apuntar o treure l'administració de cadascuna.
      match /agrupacions/{g} {
        allow read: if verified() && email() == e;
        allow create, update: if request.resource.data.keys().hasOnly(['at', 'name'])
          && (isAdmin(g) || (verified() && email() == e && creating(g)));
        allow delete: if isAdmin(g) || (verified() && email() == e);
      }
    }

    match /cors/{c} {
      match /access/{u} {
        allow read: if signedIn() && request.auth.uid == u;
        allow create, update: if signedIn() && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['role', 'key', 'at', 'memberId'])
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.choirId == c
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.role == request.resource.data.role
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.get('memberId', '') == request.resource.data.get('memberId', '');
        allow delete: if signedIn() && request.auth.uid == u;
      }
      // La configuració es crea amb l'agrupació i no es pot esborrar mai: així ningú no pot
      // tornar a «crear» una agrupació que ja té dades i fer-se'n administrador.
      match /config/main {
        allow create: if verified() && creating(c);
        // Els Ajustos els canvien l'administració, la direcció i la gerència; la identitat, només un Usuari Pro que l'administri.
        allow update: if prodEdit(c)
          && (canManage(c) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(identityKeys()));
        // La secretaria hi desa els documents del tauler i, en obrir Personal, quins rols té l'equip (per a les converses).
        allow update: if staffHas(c, ['secretaria'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents', 'teamRoles', 'syncEpoch']);
        // La comissió de festes hi desa els documents del tauler.
        allow update: if staffHas(c, ['festes'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents', 'syncEpoch']);
        // La resta de l'equip i els arxivers, en esborrar alguna cosa, només avisen els altres mòbils que la tornin a baixar
        // (syncEpoch). Un cap de corda no pot apagar les llistes privades ni canviar la norma.
        allow update: if (canEdit(c) || staffHas(c, ['archive']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncEpoch']);
      }
      match /{col}/{doc} {
        // Els comptes (staff), els aparells (push), els vots, les peticions de classe i les dades personals tenen les seves
        // regles a sota: l'equip no les llegeix totes només per editar.
        allow read: if (col in ['members', 'productions', 'config', 'subs', 'rsvp',
                                'announcements', 'polls', 'classes', 'classPlan',
                                'works', 'trips'] && canEdit(c))
                    // Les llistes: tot el cor, o la corda del cap de corda (la consulta ha de demanar només aquesta corda).
                    || (col == 'attendance' && attSec(c, resource.data.section))
                    // Cantaires i músics: veuen tota l'app (també el repertori i les sortides), però no poden canviar res.
                    || (col in ['members', 'productions', 'config', 'subs',
                                'announcements', 'polls', 'works', 'trips'] && isStaff(c))
                    // Les llistes de tothom, només si l'agrupació no les ha fet privades.
                    || (col == 'attendance' && isStaff(c) && !attPrivate(c))
                    || (col in ['productions', 'config'] && hasRole(c, ['calendar']))
                    || (col in ['members', 'productions', 'attendance', 'config', 'staff', 'subs', 'rsvp', 'absences',
                                'announcements', 'polls', 'pollVotes', 'push', 'classes', 'classReq', 'classPlan', 'classNotes', 'classIcs',
                                'works', 'trips', 'tripSignups', 'profiles', 'health', 'calKeys', 'students', 'classFiles'] && (hasRole(c, ['backup']) || isService()));
        // El tauler (anuncis, enquestes i vots, repertori i sortides) i els fitxers que s'hi pugen (config/…): qui el porta
        // (boardEdit). La plantilla, les produccions, les llistes i els substituts tenen les seves regles a sota.
        allow create, update, delete: if (boardCol(col) || (col == 'config' && doc != 'main')) && boardEdit(c);
        // La comissió de festes: el tauler menys el repertori (works), i els fitxers que s'hi pugen (config/fitxer_…). Els vots,
        // només els esborra (amb l'enquesta). La col·lecció es mira primer: així les altres escriptures no avaluen staffHas
        // un cop més (una conversa d'un cap de corda ja és a prop del límit d'expressions de les regles).
        allow create, update, delete: if (col in ['announcements', 'polls', 'trips'] || (col == 'config' && doc.matches('fitxer_[A-Za-z0-9]+_[0-9]+')))
          && staffHas(c, ['festes']);
        allow delete: if col == 'pollVotes' && staffHas(c, ['festes']);
        // Els arxivers porten el repertori: les obres (amb els seus solos, partitures i àudios) i els fitxers que s'hi
        // pugen (config/fitxer_…).
        allow create, update, delete: if staffHas(c, ['archive'])
          && (col == 'works' || (col == 'config' && doc.matches('fitxer_[A-Za-z0-9]+_[0-9]+')));
        // Els altres materials de cada producció (només el camp materials, res més): qui porta el tauler i els arxivers.
        allow update: if col == 'productions' && (boardEdit(c) || staffHas(c, ['archive']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materials', 'syncAt']);
      }
      // Les fitxes de la plantilla: qui porta les persones (Gestió › Personal). La resta de l'equip només les llegeix.
      match /members/{mid} {
        allow create, update, delete: if peopleEdit(c);
      }
      // Les produccions i les seves sessions: l'administració, la direcció i la gerència. Un cap de corda hi marca qui no fa la
      // producció (excluded) i tria qui passa llista en funcions de la seva corda (roll), i res més.
      match /productions/{pid} {
        allow create, update, delete: if prodEdit(c);
        allow update: if staffHas(c, ['leader'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excluded', 'roll', 'syncAt'])
          && request.resource.data.get('roll', {}).diff(resource.data.get('roll', {})).affectedKeys().hasOnly([staffSection(c)]);
      }
      // Arxiu de l'assistència: totes les llistes d'un tros de temporada ja acabat en un sol document (menys lectures).
      // El crea i el corregeix qui passa llista de totes les cordes; el llegeix tothom qui llegeix les llistes.
      match /attArchive/{id} {
        // Té les llistes de totes les cordes: el cap de corda no l'hi llegeix (té les de la seva a attendance, que no s'esborren).
        allow read: if attAll(c) || (isStaff(c) && !attPrivate(c)) || hasRole(c, ['backup']) || isService();
        allow create, update: if attWriteAll(c);
        allow delete: if isAdmin(c);
      }
      // Llistes privades: la còpia de les marques de cada persona. L'escriu qui passa llista (el cap de corda, només les de la
      // seva corda); la llegeix la persona i qui veu l'assistència de tot el cor.
      match /attMine/{mid} {
        allow read: if attAll(c) || (hasSpace(c) && mine(c, mid)) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if attWriteAll(c) || (staffHas(c, ['leader']) && memberSec(c, mid) == staffSection(c));
      }
      // Les produccions que farà cada persona, quan cadascú les tria (Ajustos). Les pot canviar ella mateixa o l'equip; les
      // veu tothom (com qui no fa una producció), menys amb les llistes privades, que cadascú només veu les seves.
      match /prodChoice/{mid} {
        allow read: if canEdit(c) || (hasSpace(c) && mine(c, mid)) || (isStaff(c) && !attPrivate(c)) || hasRole(c, ['backup']) || isService();
        allow create, update: if canEdit(c) || (hasSpace(c) && mine(c, mid)
          && request.resource.data.memberId == mid
          && request.resource.data.keys().hasOnly(['memberId', 'prods', 'at', 'by'])
          && request.resource.data.prods is map && request.resource.data.prods.size() <= 200
          && shortText(request.resource.data, 'at', 40) && shortText(request.resource.data, 'by', 120));
        allow delete: if canEdit(c);
      }
      // L'enllaç del cor (12c-entrar): join/<codi> porta el nom de l'agrupació, les cordes i la llista de qui encara no té
      // accés, perquè qui obre l'enllaç s'hi trobi. Només el pot llegir qui sap el codi (get, mai la llista de codis) i
      // mentre l'enllaç està actiu; l'administració el fa, el canvia i el desactiva.
      match /join/{code} {
        allow get: if verified() && resource.data.get('active', false) == true;
        allow read: if isAdmin(c) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if isAdmin(c);
      }
      // La petició de qui ha obert l'enllaç: la fa la persona mateixa (amb el seu correu i un codi actiu), només si encara no
      // té accés. La veuen ella i l'administració, que hi dona accés (crea staff/<correu>) o la rebutja (l'esborra).
      match /joinReq/{e} {
        allow read: if isAdmin(c) || (verified() && email() == e) || hasRole(c, ['backup']) || isService();
        allow create, update: if verified() && email() == e && groupOk(c) && !exists(staffPath(c))
          && request.resource.data.keys().hasOnly(['email', 'name', 'account', 'memberId', 'section', 'code', 'at'])
          && request.resource.data.email == e
          && request.resource.data.code is string && request.resource.data.code.size() <= 40
          && exists(/databases/$(database)/documents/cors/$(c)/join/$(request.resource.data.code))
          && get(/databases/$(database)/documents/cors/$(c)/join/$(request.resource.data.code)).data.get('active', false) == true
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && shortText(request.resource.data, 'account', 120) && shortText(request.resource.data, 'memberId', 60)
          && shortText(request.resource.data, 'section', 20) && shortText(request.resource.data, 'at', 40);
        allow delete: if isAdmin(c) || (verified() && email() == e);
      }
      // Quanta gent ha vist cada anunci, per cordes i sense noms: annSeen/<anunci> = { S: 12, C: 9… }, que només llegeix l'equip.
      // Cada compte amb fitxa a la plantilla hi suma 1 a la seva corda, un sol cop: en el mateix lot ha de crear
      // annSeen/<anunci>/by/<uid>, que encara no hi era i que només pot llegir ell mateix (així ningú no sap qui l'ha vist).
      // Quanta gent ha votat unes bandes, per cordes i sense noms: turnout/<votació> = { S: 12, C: 9… }, que veu tothom.
      // Cada persona hi suma 1 a la seva corda el primer cop que vota, en el mateix lot que el vot i amb
      // turnout/<votació>/by/<persona>, que només llegeix ella (així no compta dos cops i ningú no sap qui ha votat).
      // Qui porta el tauler, que llegeix tots els vots, hi posa el recompte de veritat quan no hi coincideix (els vots d'abans
      // que hi hagués aquest recompte, o de gent que ja no hi participa).
      match /turnout/{pid} {
        allow read: if isStaff(c) || hasRole(c, ['backup']) || isService();
        allow create, update: if boardPost(c);
        allow create: if votedOnce(c, pid)
          && request.resource.data.keys().hasOnly([memberSection(c)])
          && request.resource.data[memberSection(c)] == 1;
        allow update: if votedOnce(c, pid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([memberSection(c)])
          && request.resource.data[memberSection(c)] == resource.data.get(memberSection(c), 0) + 1;
        allow delete: if boardPost(c);
        match /by/{mid} {
          allow read: if hasSpace(c) && mine(c, mid);
          allow create: if hasSpace(c) && mine(c, mid)
            && request.resource.data.keys().hasOnly(['at']) && shortText(request.resource.data, 'at', 40)
            && existsAfter(/databases/$(database)/documents/cors/$(c)/turnout/$(pid));
          allow delete: if boardPost(c);
        }
      }
      // Els resultats muts d'unes bandes, quan es tanca la votació: tally/<votació> = { cats: { <categoria>: { n: [vots, de més a
      // menys], b: paperetes } }, win, sig, at }, sense cap nom, que veu tothom. Hi posa els números qui porta el tauler (que
      // llegeix tots els vots). A tallyMe/<votació>_<persona> = { pollId, memberId, cats }, en quantes categories ha rebut vots
      // cadascú: només el llegeix ella (i qui el posa); qui no n'ha rebut cap no en té.
      match /tally/{pid} {
        allow read: if isStaff(c) || hasRole(c, ['backup']) || isService();
        allow write: if boardPost(c);
      }
      match /tallyMe/{id} {
        allow get: if hasSpace(c) && id.split('_').size() == 2 && mine(c, id.split('_')[1]);
        allow read: if boardPost(c) || hasRole(c, ['backup']) || isService();
        allow write: if boardPost(c);
      }
      // Les propostes de categories d'unes bandes (catProps/<id>), abans de votar: les fa qualsevol de la plantilla, a nom seu, i
      // les veu tothom (l'app no diu de qui són); cadascú hi suma o hi treu el seu «m'agrada», i pot treure les seves. Les porta
      // qui porta el tauler (les afegeix a les categories o les descarta).
      match /catProps/{id} {
        allow read: if isStaff(c) || hasRole(c, ['backup']) || isService();
        allow create: if hasSpace(c) && mine(c, request.resource.data.get('by', '-'))
          && request.resource.data.id == id
          && request.resource.data.keys().hasOnly(['id', 'pollId', 'name', 'desc', 'pair', 'by', 'at', 'likes'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && shortText(request.resource.data, 'desc', 300) && shortText(request.resource.data, 'at', 40)
          && request.resource.data.get('likes', []).size() == 0
          && propsOpen(c, request.resource.data.pollId);
        allow update: if hasSpace(c) && myMember(c) != '-'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([myMember(c)])
          && resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet()).hasOnly([myMember(c)])
          && request.resource.data.likes.size() <= 400
          && propsOpen(c, resource.data.pollId);
        allow delete: if hasSpace(c) && mine(c, resource.data.by) && resource.data.get('taken', false) == false;
        allow update, delete: if boardPost(c);
      }
      match /annSeen/{aid} {
        allow read: if canEdit(c) || boardPost(c) || hasRole(c, ['backup']) || isService();
        allow create: if seenOnce(c, aid)
          && request.resource.data.keys().hasOnly([memberSection(c)])
          && request.resource.data[memberSection(c)] == 1;
        allow update: if seenOnce(c, aid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([memberSection(c)])
          && request.resource.data[memberSection(c)] == resource.data.get(memberSection(c), 0) + 1;
        allow delete: if isAdmin(c);
        match /by/{u} {
          allow read: if signedIn() && request.auth.uid == u;
          allow create: if signedIn() && request.auth.uid == u && isStaff(c)
            && request.resource.data.keys().hasOnly(['at']) && shortText(request.resource.data, 'at', 40)
            && existsAfter(/databases/$(database)/documents/cors/$(c)/annSeen/$(aid));
        }
      }
      // Arxiu de partitures: un document per producció, obra i corda, amb qui té la seva partitura i qui l'ha tornada.
      // El llegeix tothom de l'agrupació (cadascú hi veu la seva); el canvien qui porta el tauler i qualsevol arxiver (tots porten
      // les partitures de totes les cordes).
      match /scores/{id} {
        allow read: if isStaff(c) || hasRole(c, ['backup']) || isService();
        allow create: if boardEdit(c) || staffHas(c, ['archive']);
        allow update: if boardEdit(c) || (staffHas(c, ['archive']) && request.resource.data.section == resource.data.section);
        allow delete: if boardEdit(c);
      }
      // Codis d'arxiu i carpetes i etiquetes del cor (18c-arxiu-material): un document per corda. Els porten els arxivers i qui
      // porta les produccions (que hi posa el codi dels reforços).
      match /kit/{sec} {
        allow read: if canEdit(c) || staffHas(c, ['archive']) || hasRole(c, ['backup']) || isService();
        allow create, update: if (prodEdit(c) || staffHas(c, ['archive']))
          && request.resource.data.get('section', '') == sec
          && request.resource.data.keys().hasOnly(['section', 'codes', 'prod', 'folder', 'label', 'updatedAt', 'by']);
        allow delete: if prodEdit(c);
      }
      // Converses privades entre algú de la plantilla i l'equip (vegeu inThread). Es poden afegir missatges i marcar-les com a
      // llegides, però no canviar qui hi participa.
      match /threads/{id} {
        allow read: if inThread(c, resource.data) || hasRole(c, ['backup']) || isService();
        allow create: if isStaff(c) && inThread(c, request.resource.data)
          && request.resource.data.keys().hasAll(['memberId', 'toRole', 'toEmail', 'section', 'msgs', 'lastAt', 'lastSide'])
          && (!mine(c, request.resource.data.memberId) || request.resource.data.section == memberSection(c))
          // L'equip també pot començar una conversa amb una persona de la plantilla, a nom seu: la direcció, la gerència, la
          // secretaria, l'administració i el professorat de cant amb qualsevol; els caps de corda i els arxivers, amb la seva corda.
          && (mine(c, request.resource.data.memberId) || (request.resource.data.toEmail == email()
            && request.resource.data.toRole == '' && request.resource.data.msgs[0].side == 's'
            && (staffHas(c, ['admin', 'director', 'gerencia', 'secretaria', 'voice'])
              || (staffHas(c, ['leader', 'archive']) && request.resource.data.section == staffSection(c)
                && get(/databases/$(database)/documents/cors/$(c)/members/$(request.resource.data.memberId)).data.get('section', '-') == staffSection(c)))))
          && request.resource.data.msgs is list && request.resource.data.msgs.size() == 1
          && request.resource.data.msgs[0].by == email()
          && request.resource.data.msgs[0].text is string && request.resource.data.msgs[0].text.size() <= 2000;
        allow update: if inThread(c, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs', 'lastAt', 'lastSide', 'readM', 'readS'])
          && request.resource.data.msgs is list && request.resource.data.msgs.size() <= 300
          && request.resource.data.msgs.size() >= resource.data.msgs.size();
        allow delete: if isAdmin(c) || (hasSpace(c) && mine(c, resource.data.memberId));
      }
      // Recordatoris a qui encara no ha respost (una enquesta, una convocatòria, una sortida): els envia l'equip i els
      // reparteix avisos.py al mòbil de cadascú.
      match /nudges/{id} {
        allow read: if canEdit(c) || hasRole(c, ['backup']) || isService();
        allow create: if (canEdit(c) || boardPost(c)) && request.resource.data.by == email()
          && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 500
          && request.resource.data.kind in ['poll', 'rsvp', 'trip']
          && request.resource.data.title is string && request.resource.data.title.size() <= 300;
        allow delete: if isAdmin(c);
      }
      // Inscripcions a una sortida: cadascú diu si hi va (i una nota); qui porta el tauler les veu totes i hi posa el transport i
      // l'habitació, que la persona no es pot canviar.
      match /tripSignups/{id} {
        allow read: if boardPost(c) || (hasSpace(c) && mine(c, resource.data.memberId));
        allow create: if boardPost(c) || (hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.tripId + '_' + myMember(c)
          && request.resource.data.answer in ['yes', 'no']
          && !request.resource.data.keys().hasAny(['transport', 'room']));
        allow update: if boardPost(c) || (hasSpace(c)
          && mine(c, resource.data.memberId)
          && request.resource.data.answer in ['yes', 'no']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['transport', 'room', 'tripId', 'memberId']));
        allow delete: if boardPost(c);
      }
      // La fitxa que omple cada persona (telèfon, talla, contacte d'emergència): només la veuen ella i qui porta les persones.
      // Les al·lèrgies no hi van: són a health/<membre>.
      match /profiles/{mid} {
        allow read: if peopleEdit(c) || (hasSpace(c) && mine(c, mid));
        allow create, update: if !('diet' in request.resource.data) && (peopleEdit(c) || (hasSpace(c) && mine(c, mid)
          && request.resource.data.memberId == mid
          && request.resource.data.keys().hasOnly(['memberId', 'phone', 'size', 'emergencyName', 'emergencyPhone', 'at', 'imageOk', 'dataOk', 'consentAt'])
          && (!('imageOk' in request.resource.data) || request.resource.data.imageOk in ['yes', 'no', ''])
          && (!('dataOk' in request.resource.data) || request.resource.data.dataOk in ['yes', ''])
          && shortText(request.resource.data, 'phone', 20) && shortText(request.resource.data, 'size', 10)
          && shortText(request.resource.data, 'emergencyName', 60) && shortText(request.resource.data, 'emergencyPhone', 20)));
        allow delete: if peopleEdit(c);
      }
      // Les al·lèrgies i intoleràncies de cada persona (dades de salut), amb el seu consentiment: només les veuen ella, la
      // secretaria i la gerència. L'administració les pot desar o esborrar (en passar-les de la fitxa d'abans, o en esborrar les
      // dades d'algú), però no les llegeix.
      match /health/{mid} {
        allow read: if healthRead(c) || (hasSpace(c) && mine(c, mid)) || hasRole(c, ['backup']) || isService();
        allow create, update: if (healthRead(c) || isAdmin(c) || (hasSpace(c) && mine(c, mid)))
          && request.resource.data.memberId == mid
          && request.resource.data.keys().hasOnly(['memberId', 'diet', 'at', 'consentAt', 'by'])
          && request.resource.data.diet is string && request.resource.data.diet.size() > 0 && request.resource.data.diet.size() <= 200
          && shortText(request.resource.data, 'at', 40) && shortText(request.resource.data, 'consentAt', 40) && shortText(request.resource.data, 'by', 120);
        allow delete: if healthRead(c) || isAdmin(c) || (hasSpace(c) && mine(c, mid));
      }
      // Cadascú pot llegir la seva pròpia fitxa per saber quin rol té, i deixar-hi constància de l'última vegada que ha entrat.
      // Les fitxes de tothom, qui porta les persones (Gestió › Personal); les canvia l'administració.
      match /staff/{e} {
        allow read: if (signedIn() && email() == e) || peopleEdit(c);
        allow create: if isAdmin(c)
          || (verified() && email() == e && creating(c) && rolesOf(request.resource.data).hasAny(['admin']));
        allow delete: if isAdmin(c);
        allow update: if isAdmin(c)
          || (signedIn() && email() == e && groupOk(c)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      }
      // Avisos al mòbil: cada aparell es dona d'alta ell mateix i només toca la seva fitxa. Qui porta les persones veu qui els té
      // activats (a «Qui ha entrat»).
      match /push/{id} {
        allow read: if (signedIn() && resource.data.uid == request.auth.uid) || peopleEdit(c);
        allow create: if hasSpace(c) && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid && groupOk(c);
        allow delete: if isAdmin(c) || (signedIn() && resource.data.uid == request.auth.uid);
      }
      // Classes de cant: el calendari el fa el professorat; tothom de l'agrupació el pot veure.
      match /classes/{id} {
        allow read: if isStaff(c) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if teaches(c);
      }
      // L'horari fix de cada professor/a: un document per professor/a, per generar els trimestres.
      match /classPlan/{id} {
        allow read: if isStaff(c) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if teaches(c);
      }
      // La clau del calendari de classes de cada persona: només la seva.
      match /classIcs/{mid} {
        allow read: if teaches(c) || (hasSpace(c) && mine(c, mid)) || hasRole(c, ['backup']) || isService();
        allow create, update: if hasSpace(c) && mine(c, mid)
          && request.resource.data.keys().hasOnly(['memberId', 'token', 'at'])
          && request.resource.data.memberId == mid
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 24 && request.resource.data.token.size() <= 64;
        allow delete: if teaches(c) || (hasSpace(c) && mine(c, mid));
      }
      // La clau del calendari personal de cadascú (les sessions on és convocat, amb tots els detalls, i les seves classes): només
      // la seva. La tasca «Publica» n'escriu el fitxer, que només troba qui sap la clau.
      match /calKeys/{mid} {
        allow read: if (hasSpace(c) && mine(c, mid)) || hasRole(c, ['backup']) || isService();
        allow create, update: if hasSpace(c) && mine(c, mid)
          && request.resource.data.keys().hasOnly(['memberId', 'token', 'at'])
          && request.resource.data.memberId == mid
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 24 && request.resource.data.token.size() <= 64;
        allow delete: if isAdmin(c) || (hasSpace(c) && mine(c, mid));
      }
      // Missatges dins l'app: el cap de corda escriu només a la seva corda; administració, direcció, gerència,
      // secretaria i la comissió de festes, a tothom ('*'), a les cordes que triïn o a qui fa una producció (members: la llista
      // de qui la fa). Cadascú llegeix els de la seva corda, els de tothom, els que porten el seu nom a members i els seus.
      match /messages/{id} {
        allow read: if canEdit(c) || hasRole(c, ['backup']) || isService()
          || (isStaff(c) && ('*' in resource.data.to || memberSection(c) in resource.data.to))
          || (isStaff(c) && myMember(c) in resource.data.get('members', []))
          || (isStaff(c) && resource.data.by == email());
        // Els arxivers també escriuen a la seva corda (p. ex. per recordar que cal tornar les partitures).
        allow create: if (canEdit(c) || staffHas(c, ['archive', 'festes']))
          && request.resource.data.by == email()
          && request.resource.data.to is list && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 20
          && request.resource.data.body is string && request.resource.data.body.size() <= 2000
          && (!('members' in request.resource.data) || (request.resource.data.members is list && request.resource.data.members.size() <= 400))
          && (staffHas(c, ['admin', 'director', 'gerencia', 'secretaria', 'festes'])
              || (request.resource.data.to == [staffSection(c)] && !('members' in request.resource.data)));
        allow delete: if isAdmin(c) || ((canEdit(c) || staffHas(c, ['archive', 'festes'])) && resource.data.by == email());
      }
      // Notes de seguiment de cada persona: només la direcció, l'administració i els caps de corda (de la seva corda).
      match /memberNotes/{id} {
        allow read: if staffHas(c, ['admin', 'director']) || hasRole(c, ['backup']) || isService()
          || (staffHas(c, ['leader']) && resource.data.section == staffSection(c));
        allow create: if (staffHas(c, ['admin', 'director']) || (staffHas(c, ['leader']) && request.resource.data.section == staffSection(c)))
          && request.resource.data.by == email()
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if staffHas(c, ['admin', 'director']) || (staffHas(c, ['leader']) && resource.data.by == email());
      }
      // Secretaria: documents (drets d'imatge, dades, autoritzacions) i quotes de cada persona, i els documents signats.
      match /memberDocs/{mid} {
        allow read: if staffHas(c, ['admin', 'secretaria', 'gerencia', 'director']) || (hasSpace(c) && mine(c, mid)) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if staffHas(c, ['admin', 'secretaria', 'gerencia']);
      }
      // Vestidor: una peça de vestuari per document (vegeu 20b-vestidor). La persona demana la seva («demanat») i, mentre
      // ningú no l'ha encarregada, en pot canviar la talla o anul·lar-la; la resta la porten la secretaria, la gerència i
      // l'administració. Cadascú només veu les seves peces.
      match /wardrobe/{id} {
        allow read: if wardStaff(c) || (hasSpace(c) && mine(c, resource.data.memberId)) || hasRole(c, ['backup']) || isService();
        allow create: if wardStaff(c) || (hasSpace(c) && mine(c, request.resource.data.memberId)
          && request.resource.data.status == 'demanat' && wardOwn(request.resource.data));
        allow update: if wardStaff(c) || (hasSpace(c) && mine(c, resource.data.memberId) && resource.data.status == 'demanat'
          && request.resource.data.status == 'demanat' && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.item == resource.data.item && wardOwn(request.resource.data));
        allow delete: if wardStaff(c) || (hasSpace(c) && mine(c, resource.data.memberId) && resource.data.status == 'demanat');
      }
      // Amb les llistes privades, el que la resta de la plantilla no ha de veure de cada fitxa (telèfon, notes, baixes i
      // altes amb els motius) va aquí. La llegeixen qui porta les persones i la persona; si les llistes no són privades,
      // tothom (com la fitxa mateixa). Les dates de les baixes, sense el motiu, són a la fitxa (away).
      match /memberPriv/{mid} {
        allow read: if peopleEdit(c) || (hasSpace(c) && mine(c, mid)) || (isStaff(c) && !attPrivate(c)) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if peopleEdit(c);
      }
      match /memberFiles/{id} {
        allow read: if staffHas(c, ['admin', 'secretaria', 'gerencia', 'director']) || (hasSpace(c) && mine(c, resource.data.memberId)) || hasRole(c, ['backup']) || isService();
        allow create, update, delete: if staffHas(c, ['admin', 'secretaria', 'gerencia']);
      }
      // La fitxa de cant de cada alumne (objectius i repertori): la fa el seu professorat (teachers) i la veu l'alumne.
      match /students/{mid} {
        allow read: if teachersOf(c, resource.data) || (hasSpace(c) && mine(c, mid));
        allow create: if teachersOf(c, request.resource.data);
        allow update: if teachersOf(c, resource.data) && teachersOf(c, request.resource.data);
        allow delete: if teachersOf(c, resource.data);
      }
      // Enregistraments de classe, a trossos com els fitxers del tauler: només el professor que els ha pujat i l'alumne.
      match /classFiles/{id} {
        allow read: if teacherOf(c, resource.data) || (hasSpace(c) && mine(c, resource.data.memberId));
        allow create: if teacherOf(c, request.resource.data);
        allow update: if teacherOf(c, resource.data) && teacherOf(c, request.resource.data);
        allow delete: if teacherOf(c, resource.data);
      }
      // Les notes de cada classe: només les veuen el professor de la classe i l'alumne de qui són.
      match /classNotes/{id} {
        allow read: if teacherOf(c, resource.data) || (hasSpace(c) && mine(c, resource.data.memberId)) || hasRole(c, ['backup']) || isService();
        allow create: if teacherOf(c, request.resource.data);
        allow update: if teacherOf(c, resource.data) && teacherOf(c, request.resource.data);
        allow delete: if teacherOf(c, resource.data);
      }
      // Avisos de retard o absència a una classe i peticions de canvi d'hora entre companys: el professorat i qui hi surt.
      match /classReq/{id} {
        allow read: if teaches(c)
          // Un canvi d'hora obert el pot veure tothom de l'agrupació: és una crida a qui pugui.
          || (hasSpace(c) && (resource.data.get('open', false) == true || mine(c, resource.data.memberId) || mine(c, resource.data.get('withMemberId', '-'))));
        allow create: if hasSpace(c)
          && request.resource.data.uid == request.auth.uid
          && mine(c, request.resource.data.memberId)
          && request.resource.data.kind in ['late', 'absent', 'swap', 'take']
          && request.resource.data.status == 'pending'
          && (request.resource.data.kind != 'swap' || request.resource.data.get('withMemberId', '-') != myMember(c));
        allow update: if teaches(c)
          // Canvi obert (a tothom o a unes quantes persones, «to»): qui se'l queda s'hi posa ell mateix, amb la seva hora
          // d'aquell dia o de l'altre dia de la setmana (withClassId), i queda acceptat.
          || (hasSpace(c) && resource.data.kind == 'swap' && !('withMemberId' in resource.data)
              && resource.data.status == 'pending'
              && (!('to' in resource.data) || myMember(c) in resource.data.to)
              && request.resource.data.status == 'accepted'
              && request.resource.data.withMemberId == myMember(c)
              && request.resource.data.memberId != myMember(c)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'withMemberId', 'withSlotId', 'withClassId', 'open']))
          // El company a qui es demana el canvi: només pot respondre que sí o que no.
          || (hasSpace(c) && mine(c, resource.data.get('withMemberId', '-'))
              && resource.data.status == 'pending'
              && request.resource.data.status in ['accepted', 'rejected']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']))
          // Qui l'ha demanat: només la pot retirar mentre ningú no hagi respost.
          || (hasSpace(c) && mine(c, resource.data.memberId)
              && resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']));
        allow delete: if teaches(c) || (hasSpace(c) && mine(c, resource.data.memberId) && resource.data.status == 'pending');
      }
      // Restes dels enllaços personals d'abans del setembre del 2026 (còpies de les marques i les claus): ja no es fan servir.
      // Només l'administració les pot mirar i esborrar (Ajustos › Dades › Restes de versions antigues).
      match /memberMarks/{mid} {
        allow read, delete: if isAdmin(c);
      }
      // Els vots de les enquestes: cadascú el seu; els de tothom, qui porta el tauler (per als resultats i els recordatoris).
      match /pollVotes/{id} {
        allow read: if (hasSpace(c) && mine(c, resource.data.memberId)) || boardPost(c);
        allow create, update: if hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.pollId + '_' + myMember(c)
          && get(/databases/$(database)/documents/cors/$(c)/polls/$(request.resource.data.pollId)).data.get('closed', false) == false;
      }
      match /secrets/{doc} {
        allow read, delete: if isAdmin(c);
      }
      // Les llistes: una per sessió i corda (attendance/<sessió>_<corda>), que no canvia de corda. Les passen l'administració i la
      // direcció (de totes les cordes) i el cap de corda (de la seva).
      match /attendance/{id} {
        allow create, update: if attSecW(c, request.resource.data.get('section', ''))
          && id == request.resource.data.get('sessionId', '') + '_' + request.resource.data.get('section', '')
          && (resource == null || resource.data.get('section', '') == request.resource.data.get('section', ''));
        allow delete: if attSecW(c, resource.data.get('section', ''));
        // Substitut: pot passar llista d'aquella sessió i secció fins que caduca.
        allow read: if hasSpace(c)
          && exists(/databases/$(database)/documents/cors/$(c)/subs/$(id))
          && mine(c, get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.memberId)
          && request.time.toMillis() < get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.until;
        allow create, update: if hasSpace(c)
          && exists(/databases/$(database)/documents/cors/$(c)/subs/$(id))
          && mine(c, get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.memberId)
          && request.time.toMillis() < get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.until
          && request.resource.data.get('section', '') == get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.get('section', '-');
      }
      // Qui passa llista d'una sessió quan no hi és el cap de corda: el tria qui porta les produccions (de qualsevol corda) o el
      // cap de corda (de la seva). Tothom de l'agrupació veu qui és (vegeu a dalt).
      match /subs/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
        allow create, update: if (prodEdit(c) || (staffHas(c, ['leader']) && staffSection(c) == request.resource.data.get('section', '')))
          && subOk(id, request.resource.data)
          && (resource == null || resource.data.get('section', '') == request.resource.data.get('section', ''));
        allow delete: if prodEdit(c) || (staffHas(c, ['leader']) && staffSection(c) == resource.data.get('section', ''));
      }
      // Els avisos d'absència: els respon el cap de corda (de la seva corda), la direcció i l'administració; la gerència els veu
      // (vegeu attSec). La persona veu i retira els seus.
      match /absences/{id} {
        allow read: if attSec(c, resource.data.section) || (hasSpace(c) && mine(c, resource.data.memberId));
        allow create: if request.resource.data.uid == request.auth.uid
          && (attSecW(c, request.resource.data.get('section', '')) || (hasSpace(c) && request.resource.data.status == 'pending' && mine(c, request.resource.data.memberId)));
        allow update: if attSecW(c, resource.data.get('section', '')) && request.resource.data.get('section', '') == resource.data.get('section', '');
        allow delete: if attSecW(c, resource.data.get('section', ''))
          || (hasSpace(c) && mine(c, resource.data.memberId) && resource.data.status == 'pending');
      }
      // Les respostes a les convocatòries: cadascú la seva (l'equip les veu totes, vegeu a dalt). Les esborra l'administració, en
      // esborrar les dades d'algú.
      match /rsvp/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
        allow create, update: if hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.sessionId + '_' + myMember(c)
          && request.resource.data.answer in ['yes', 'no'];
        allow delete: if isAdmin(c);
      }
    }
  }
}
