rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Agrupacions ----
    // L'app pot allotjar moltes agrupacions (cors, orquestres, bandes…). Cadascuna té les seves
    // dades a cors/<agrupació>/… i una fitxa al directori agrupacions/<agrupació> amb el nom,
    // el tipus i l'estat (active | suspended | deleted). Cap agrupació pot veure res d'una altra.
    //
    // ---- Qui és qui dins d'una agrupació ----
    // Ningú no hi entra sense identificar-se: tothom entra amb el seu compte de Google i té una fitxa
    // a cors/<agrupació>/staff/<correu> amb un o més rols (roles; les fitxes antigues, un sol role):
    //   admin                     → ho pot fer tot: persones, identitat, dades
    //   director | leader | palau → passen llista, publiquen avisos, pugen documents… (leader = cap de corda o de secció)
    //   singer                    → només lectura de tota l'app
    // La fitxa pot portar memberId: llavors la persona té el seu espai personal, sigui quin sigui el rol.
    // Cada persona té un índex de les seves agrupacions a staffIndex/<correu>/agrupacions/<agrupació>.
    //
    // ---- Plataforma ----
    // plataforma/equip diu qui porta la plataforma (veu el directori i pot suspendre agrupacions,
    // però no les dades de dins). plataforma/config diu si qualsevol pot crear agrupacions.
    // El compte de servei (avisos, calendari, còpies) llegeix totes les agrupacions i no escriu res.
    //
    // ---- Lectors antics de les tasques automàtiques ----
    // claus/<secret> diu l'agrupació i el rol (calendar o backup); cada lector anònim es registra a
    // cors/<agrupació>/access/<uid>. Només llegeixen. Ja no hi ha cap enllaç per entrar a l'app.

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', '').lower(); }
    function verified() { return signedIn() && request.auth.token.get('email_verified', false) == true; }

    // Primera agrupació: la seva administració pot activar el panell de plataforma el primer cop.
    function founder() { return 'nSN9kYDkzPik239jnsMsCSYW'; }
    function isService() { return signedIn() && request.auth.uid in ['sZy09w2YOfdv2jky8zy5m7Vzfna2']; }
    function isPlatform() {
      return verified()
        && exists(/databases/$(database)/documents/plataforma/equip)
        && email() in get(/databases/$(database)/documents/plataforma/equip).data.emails;
    }

    function dirDoc(c) { return /databases/$(database)/documents/agrupacions/$(c); }
    // Una agrupació sense fitxa al directori (la primera, abans de registrar-la) compta com a activa.
    function groupOk(c) { return !exists(dirDoc(c)) || get(dirDoc(c)).data.get('status', 'active') == 'active'; }
    function staffPath(c) { return /databases/$(database)/documents/cors/$(c)/staff/$(email()); }
    // Té fitxa a l'agrupació, encara que estigui suspesa (per poder-li dir).
    function isMember(c) { return verified() && exists(staffPath(c)); }
    function isStaff(c) { return isMember(c) && groupOk(c); }
    function staffData(c) { return get(staffPath(c)).data; }
    function hasRole(c, roles) {
      let accP = /databases/$(database)/documents/cors/$(c)/access/$(request.auth.uid);
      return signedIn()
        && exists(accP)
        && get(accP).data.role in roles
        && exists(/databases/$(database)/documents/claus/$(get(accP).data.key))
        && groupOk(c);
    }
    // Els rols d'una fitxa: la llista roles o, a les fitxes d'abans, el rol únic.
    function rolesOf(d) { return d.get('roles', [d.get('role', '')]); }

    function canEdit(c) { return isStaff(c) && rolesOf(staffData(c)).hasAny(['admin', 'director', 'leader', 'palau']); }
    function isAdmin(c) { return isStaff(c) && rolesOf(staffData(c)).hasAny(['admin']); }
    // El membre de la plantilla de qui som (si la fitxa en porta).
    function myMember(c) { return staffData(c).get('memberId', '-'); }
    // Té espai personal: pot avisar, confirmar, votar i fer de substitut.
    function hasSpace(c) { return isStaff(c); }
    function mine(c, mid) { return mid == myMember(c) && mid != '-'; }

    // Es crea una agrupació nova en aquest mateix lot d'escriptures: abans no hi havia res i després sí.
    function creating(c) {
      return !exists(dirDoc(c)) && existsAfter(dirDoc(c))
        && !exists(/databases/$(database)/documents/cors/$(c)/config/main)
        && existsAfter(/databases/$(database)/documents/cors/$(c)/config/main);
    }
    function creationOpen() {
      return !exists(/databases/$(database)/documents/plataforma/config)
        || get(/databases/$(database)/documents/plataforma/config).data.get('openCreation', true) == true;
    }

    match /plataforma/equip {
      allow get: if isPlatform() || resource == null;
      allow create: if verified()
        && exists(/databases/$(database)/documents/cors/$(founder())/staff/$(email()))
        && rolesOf(get(/databases/$(database)/documents/cors/$(founder())/staff/$(email())).data).hasAny(['admin'])
        && request.resource.data.keys().hasOnly(['emails', 'at'])
        && request.resource.data.emails == [email()];
      allow update: if isPlatform()
        && request.resource.data.keys().hasOnly(['emails', 'at'])
        && request.resource.data.emails is list
        && email() in request.resource.data.emails;
    }
    match /plataforma/config {
      allow get: if signedIn();
      allow create, update: if isPlatform();
    }

    match /agrupacions/{c} {
      allow get: if isPlatform() || isService() || isMember(c);
      allow list: if isPlatform() || isService();
      // Nova agrupació: qui la crea en queda d'administrador, tot en un sol lot.
      allow create: if c.size() >= 20 && c.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'kind', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.status == 'active'
        && ((verified() && (creationOpen() || isPlatform())
              && request.resource.data.createdBy == email()
              && creating(c)
              && rolesOf(getAfter(/databases/$(database)/documents/cors/$(c)/staff/$(email())).data).hasAny(['admin']))
            // Registrar al directori una agrupació que ja existia d'abans.
            || (isAdmin(c) && exists(/databases/$(database)/documents/cors/$(c)/config/main)));
      allow update: if isPlatform()
        || (isAdmin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'kind', 'stats'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80)
        || (canEdit(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']))
        || (isAdmin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt'])
            && request.resource.data.status == 'deleted');
      allow delete: if isPlatform();
    }

    match /claus/{k} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && k.size() >= 24
        && request.resource.data.keys().hasOnly(['choirId', 'role', 'at', 'memberId'])
        && request.resource.data.role in ['calendar', 'backup']
        && isAdmin(request.resource.data.choirId);
      allow delete: if isAdmin(resource.data.choirId);
    }

    match /staffIndex/{e} {
      // Índex antic (una sola agrupació per correu). Ja no s'hi escriu, però es llegeix si falta el nou.
      allow get: if verified() && email() == e;
      allow create: if request.resource.data.keys().hasOnly(['choirId'])
        && request.resource.data.choirId == founder() && isAdmin(founder());
      allow update: if request.resource.data.keys().hasOnly(['choirId'])
        && resource.data.choirId == request.resource.data.choirId && isAdmin(resource.data.choirId);
      allow delete: if isAdmin(resource.data.choirId);

      // Les agrupacions de cada persona: només les pot apuntar o treure l'administració de cadascuna.
      match /agrupacions/{g} {
        allow read: if verified() && email() == e;
        allow create, update: if request.resource.data.keys().hasOnly(['at', 'name'])
          && (isAdmin(g) || (verified() && email() == e && creating(g)));
        allow delete: if isAdmin(g) || (verified() && email() == e);
      }
    }

    match /cors/{c} {
      match /access/{u} {
        allow read: if signedIn() && request.auth.uid == u;
        allow create, update: if signedIn() && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['role', 'key', 'at', 'memberId'])
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.choirId == c
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.role == request.resource.data.role
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.get('memberId', '') == request.resource.data.get('memberId', '');
        allow delete: if signedIn() && request.auth.uid == u;
      }
      // La configuració es crea amb l'agrupació i no es pot esborrar mai: així ningú no pot
      // tornar a «crear» una agrupació que ja té dades i fer-se'n administrador.
      match /config/main {
        allow create: if verified() && creating(c);
      }
      match /{col}/{doc} {
        allow read: if (col in ['members', 'productions', 'attendance', 'config', 'staff', 'subs', 'rsvp', 'absences',
                                'announcements', 'polls', 'pollVotes', 'memberMarks', 'push'] && canEdit(c))
                    // Cantaires i músics: veuen tota l'app, però no poden canviar res.
                    || (col in ['members', 'productions', 'attendance', 'config', 'subs',
                                'announcements', 'polls'] && isStaff(c))
                    || (col in ['productions', 'config'] && hasRole(c, ['calendar']))
                    || (col in ['members', 'productions', 'attendance', 'config', 'staff', 'subs', 'rsvp', 'absences',
                                'announcements', 'polls', 'pollVotes', 'push'] && (hasRole(c, ['backup']) || isService()));
        allow create, update: if col in ['members', 'productions', 'attendance', 'config', 'subs', 'rsvp',
                                         'announcements', 'polls', 'pollVotes', 'memberMarks'] && canEdit(c);
        allow delete: if col in ['members', 'productions', 'attendance', 'config', 'subs', 'rsvp',
                                 'announcements', 'polls', 'pollVotes', 'memberMarks'] && canEdit(c)
          && !(col == 'config' && doc == 'main');
      }
      // Cadascú pot llegir la seva pròpia fitxa per saber quin rol té, i deixar-hi
      // constància de l'última vegada que ha entrat. La resta, només administració.
      match /staff/{e} {
        allow read: if signedIn() && email() == e;
        allow create: if isAdmin(c)
          || (verified() && email() == e && creating(c) && rolesOf(request.resource.data).hasAny(['admin']));
        allow delete: if isAdmin(c);
        allow update: if isAdmin(c)
          || (signedIn() && email() == e && groupOk(c)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      }
      // Avisos al mòbil: cada aparell es dona d'alta ell mateix i només toca la seva fitxa.
      match /push/{id} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if (hasSpace(c) || canEdit(c)) && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid && groupOk(c);
        allow delete: if canEdit(c) || (signedIn() && resource.data.uid == request.auth.uid);
      }
      // Còpia de les marques de cada cantaire: només les seves.
      match /memberMarks/{mid} {
        allow read: if hasSpace(c) && mine(c, mid);
      }
      match /pollVotes/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
        allow create, update: if hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.pollId + '_' + myMember(c)
          && get(/databases/$(database)/documents/cors/$(c)/polls/$(request.resource.data.pollId)).data.get('closed', false) == false;
      }
      match /secrets/{doc} {
        allow read, write: if canEdit(c);
      }
      // Substitut: pot passar llista d'aquella sessió i secció fins que caduca.
      match /attendance/{id} {
        allow read, write: if hasSpace(c)
          && exists(/databases/$(database)/documents/cors/$(c)/subs/$(id))
          && mine(c, get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.memberId)
          && request.time.toMillis() < get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.until;
      }
      match /subs/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
      }
      match /absences/{id} {
        allow read: if canEdit(c) || (hasSpace(c) && mine(c, resource.data.memberId));
        allow create: if request.resource.data.uid == request.auth.uid
          && (canEdit(c) || (hasSpace(c) && request.resource.data.status == 'pending' && mine(c, request.resource.data.memberId)));
        allow update: if canEdit(c);
        allow delete: if canEdit(c)
          || (hasSpace(c) && mine(c, resource.data.memberId) && resource.data.status == 'pending');
      }
      match /rsvp/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
        allow create, update: if hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.sessionId + '_' + myMember(c)
          && request.resource.data.answer in ['yes', 'no'];
      }
    }
  }
}
