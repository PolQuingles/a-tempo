rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Qui és qui ----
    // Tothom (equip i cantaires) entra amb el seu compte de Google i té una fitxa
    // a cors/<cor>/staff/<correu> amb un rol:
    //   admin | director | leader  → poden editar-ho tot (leader = cap de corda)
    //   singer | palau             → només lectura de tota l'app
    // La fitxa pot portar memberId: llavors la persona té el seu espai personal
    // (avisos d'absència, confirmacions, enquestes, la seva assistència).
    //
    // Enllaços antics (#k=…): claus/<secret> diu el cor i el rol; cada mòbil anònim
    // es registra a cors/<cor>/access/<uid>.
    //   edit     → enllaç compartit d'edició (transició)
    //   singer   → enllaç personal d'un cantaire (memberId)
    //   calendar → lector del calendari per generar el fitxer .ics
    //   backup   → lector de totes les dades per a la còpia de seguretat diària

    function email() { return request.auth.token.get('email', '').lower(); }
    function isStaff(c) {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/cors/$(c)/staff/$(email()));
    }
    function staffData(c) { return get(/databases/$(database)/documents/cors/$(c)/staff/$(email())).data; }
    function hasRole(c, roles) {
      let accP = /databases/$(database)/documents/cors/$(c)/access/$(request.auth.uid);
      return request.auth != null
        && exists(accP)
        && get(accP).data.role in roles
        && exists(/databases/$(database)/documents/claus/$(get(accP).data.key));
    }
    function accMember(c) { return get(/databases/$(database)/documents/cors/$(c)/access/$(request.auth.uid)).data.get('memberId', '-'); }

    function canEdit(c) { return hasRole(c, ['edit']) || (isStaff(c) && staffData(c).role in ['admin', 'director', 'leader']); }
    function isAdmin(c) { return hasRole(c, ['edit']) || (isStaff(c) && staffData(c).role == 'admin'); }
    function isSinger(c) { return hasRole(c, ['singer']); }
    // El cantaire de qui som: de la fitxa (compte) o de l'enllaç personal.
    function myMember(c) { return isStaff(c) ? staffData(c).get('memberId', '-') : accMember(c); }
    // Té espai personal: pot avisar, confirmar, votar i fer de substitut.
    function hasSpace(c) { return isStaff(c) || isSinger(c); }
    function mine(c, mid) { return mid == myMember(c) && mid != '-'; }

    match /claus/{k} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && k.size() >= 24
        && request.resource.data.keys().hasOnly(['choirId', 'role', 'at', 'memberId'])
        && request.resource.data.role in ['edit', 'singer', 'calendar', 'backup']
        && ((request.resource.data.role == 'singer' && canEdit(request.resource.data.choirId))
            || isAdmin(request.resource.data.choirId)
            || (!exists(/databases/$(database)/documents/cors/$(request.resource.data.choirId)/config/main)
                && existsAfter(/databases/$(database)/documents/cors/$(request.resource.data.choirId)/config/main)));
      allow delete: if (resource.data.role == 'singer' && canEdit(resource.data.choirId)) || isAdmin(resource.data.choirId);
    }

    match /staffIndex/{e} {
      allow get: if request.auth != null && request.auth.token.get('email_verified', false) == true && email() == e;
      allow create, update: if request.resource.data.keys().hasOnly(['choirId']) && isAdmin(request.resource.data.choirId);
      allow delete: if isAdmin(resource.data.choirId);
    }

    match /cors/{c} {
      match /access/{u} {
        allow read: if request.auth != null && request.auth.uid == u;
        allow create, update: if request.auth != null && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['role', 'key', 'at', 'memberId'])
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.choirId == c
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.role == request.resource.data.role
          && getAfter(/databases/$(database)/documents/claus/$(request.resource.data.key)).data.get('memberId', '') == request.resource.data.get('memberId', '');
        allow delete: if request.auth != null && request.auth.uid == u;
      }
      match /config/main {
        allow create: if request.auth != null && !exists(/databases/$(database)/documents/cors/$(c)/config/main);
      }
      match /{col}/{doc} {
        allow read: if (col in ['members', 'productions', 'attendance', 'config', 'staff', 'subs', 'rsvp', 'absences',
                                'announcements', 'polls', 'pollVotes', 'memberMarks', 'push'] && canEdit(c))
                    // Cantaires i treballadors del Palau: veuen tota l'app, però no poden canviar res.
                    || (col in ['members', 'productions', 'attendance', 'config', 'subs',
                                'announcements', 'polls'] && isStaff(c))
                    || (col in ['members', 'productions', 'config', 'announcements', 'polls'] && isSinger(c))
                    || (col in ['productions', 'config'] && hasRole(c, ['calendar']))
                    || (col in ['members', 'productions', 'attendance', 'config', 'staff', 'subs', 'rsvp', 'absences',
                                'announcements', 'polls', 'pollVotes', 'push'] && hasRole(c, ['backup']));
        allow write: if col in ['members', 'productions', 'attendance', 'config', 'subs', 'rsvp',
                                'announcements', 'polls', 'pollVotes', 'memberMarks'] && canEdit(c);
      }
      // Cadascú pot llegir la seva pròpia fitxa per saber quin rol té, i deixar-hi
      // constància de l'última vegada que ha entrat. La resta, només administració.
      match /staff/{e} {
        allow read: if request.auth != null && email() == e;
        allow create, delete: if isAdmin(c);
        allow update: if isAdmin(c)
          || (request.auth != null && email() == e
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      }
      // Avisos al mòbil: cada aparell es dona d'alta ell mateix i només toca la seva fitxa.
      match /push/{id} {
        allow read: if request.auth != null && resource.data.uid == request.auth.uid;
        allow create: if (hasSpace(c) || canEdit(c)) && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if canEdit(c) || (request.auth != null && resource.data.uid == request.auth.uid);
      }
      // Còpia de les marques de cada cantaire: només les seves.
      match /memberMarks/{mid} {
        allow read: if hasSpace(c) && mine(c, mid);
      }
      match /pollVotes/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
        allow create, update: if hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.pollId + '_' + myMember(c)
          && get(/databases/$(database)/documents/cors/$(c)/polls/$(request.resource.data.pollId)).data.get('closed', false) == false;
      }
      match /secrets/{doc} {
        allow read, write: if canEdit(c);
      }
      // Substitut: pot passar llista d'aquella sessió i corda fins que caduca.
      match /attendance/{id} {
        allow read, write: if hasSpace(c)
          && exists(/databases/$(database)/documents/cors/$(c)/subs/$(id))
          && mine(c, get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.memberId)
          && request.time.toMillis() < get(/databases/$(database)/documents/cors/$(c)/subs/$(id)).data.until;
      }
      match /subs/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
      }
      match /absences/{id} {
        allow read: if canEdit(c) || (hasSpace(c) && mine(c, resource.data.memberId));
        allow create: if request.resource.data.uid == request.auth.uid
          && (canEdit(c) || (hasSpace(c) && request.resource.data.status == 'pending' && mine(c, request.resource.data.memberId)));
        allow update: if canEdit(c);
        allow delete: if canEdit(c)
          || (hasSpace(c) && mine(c, resource.data.memberId) && resource.data.status == 'pending');
      }
      match /rsvp/{id} {
        allow read: if hasSpace(c) && mine(c, resource.data.memberId);
        allow create, update: if hasSpace(c)
          && mine(c, request.resource.data.memberId)
          && id == request.resource.data.sessionId + '_' + myMember(c)
          && request.resource.data.answer in ['yes', 'no'];
      }
    }
  }
}
